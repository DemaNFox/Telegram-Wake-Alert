APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash
TELEGRAM_SESSION_NAME=telegram_alarm

WS_AUTH_TOKEN=replace_with_long_random_token
HEARTBEAT_INTERVAL_SECONDS=20
TELEGRAM_RECONNECT_MIN_SECONDS=2
TELEGRAM_RECONNECT_MAX_SECONDS=60

FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_INSTALLATION_STORE_PATH=data/fcm_installations.json
